<header data-testid="store-header" class="store-header orv-header">
  <div class="orv-announcement"><div class="container">ORV • OVERLANDING SOLUTIONS • WORKSHOP INSTALLATION</div></div>
  <div id="mainnav" class="orv-mainnav">
    <div class="container orv-mainnav__inner">
      <div class="orv-mainnav__left">
        <a data-testid="store-header-mobile-toggle" class="lg:hidden orv-menu-toggle" href="#mobile-menu" aria-label="Open-menu"><i class="sicon-menu"></i></a>
        <a data-testid="store-header-logo" class="orv-logo" href="{{ store.url }}">
          <img fetchpriority="high" loading="eager" src="{{ store.logo|cdn(220) }}" alt="{{ store.name }} logo">
          {% if is_page('index') %}<h1 class="sr-only">{{ store.name }}</h1>{% endif %}
        </a>
        <custom-main-menu></custom-main-menu>
      </div>
      <div class="orv-mainnav__actions">
        <button class="orv-icon-btn hidden sm:grid" onclick="salla.event.dispatch('search::open')" aria-label="Search"><i class="sicon-search"></i></button>
        <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger></salla-user-menu>
        <salla-cart-summary data-testid="store-header-cart" class="orv-cart"><i slot="icon" class="sicon-shopping-bag"></i></salla-cart-summary>
      </div>
    </div>
  </div>
</header>
